{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2021"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "vscode"],
    "rootDir": ".",
    "outDir": "dist-test",
    "sourceMap": true
  },
  "include": ["test/extension/**/*.ts"],
  "exclude": ["node_modules", ".vscode-test"]
}
